{
  "name": "storymaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "剧情对话编辑器",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode singlefile && vite-node tools/make-launcher.mts",
    "build:app": "tsc -b && vite build && electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:release": "vite-node tools/verify-release.mts",
    "verify:server": "vite-node tools/verify-server.mts",
    "verify:update": "vite-node tools/verify-update.mts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "electron-winstaller"]
  },
  "build": {
    "appId": "com.storymaker.app",
    "productName": "StoryMaker",
    "directories": {
      "output": "app-release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": ["dist/**/*", "electron/**/*", "build/icon.ico", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
